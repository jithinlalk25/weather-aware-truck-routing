# Local development. On Railway set DEBUG=0 and real values.
DEBUG=1
SECRET_KEY=dev-insecure-key
TOMTOM_API_KEY=

# Production only (Railway). ALLOWED_HOSTS automatically includes
# RAILWAY_PUBLIC_DOMAIN and healthcheck.railway.app; add custom domains here.
# DATABASE_URL=${{Postgres.DATABASE_URL}}  (reference variable; required when DEBUG=0)
# CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
# CORS_ALLOWED_ORIGIN_REGEXES=^https://your-app-.*\.vercel\.app$   (optional: preview URLs)
# CSRF_TRUSTED_ORIGINS=https://your-app.up.railway.app                (Django admin)
# OPEN_METEO_API_KEY=                     (optional commercial key)
